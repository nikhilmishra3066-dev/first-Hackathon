# Copy to .env.local for local development. Set the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.

# Signs the OTP tokens (any long random string, e.g. `openssl rand -hex 32`).
OTP_SECRET=

# Account storage. Create a Redis database from Vercel → Storage (Upstash Redis)
# and connect it to the project; the variables below are added automatically.
# Both the Vercel (`KV_*`) and Upstash (`UPSTASH_REDIS_REST_*`) names work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email delivery via Resend (https://resend.com → API Keys).
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. onboarding@resend.dev only
# delivers to the Resend account owner's own email address.
OTP_FROM_EMAIL=SafeHer <onboarding@resend.dev>

# SMS delivery via Fast2SMS (https://www.fast2sms.com → Dev API).
# Indian numbers need an approved DLT template and wallet balance.
FAST2SMS_AUTH_KEY=
FAST2SMS_ROUTE=otp

# Email delivery via your own Gmail (no third-party signup). Use an App Password:
# Google Account → Security → 2-Step Verification → App passwords. Requires 2FA on.
# This sends real email to ANY address from the Vite dev/preview server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional: force demo mode (code printed to the SERVER terminal only, never the
# browser and never emailed). On by default outside production. Never rely on it publicly.
# OTP_DEMO=
