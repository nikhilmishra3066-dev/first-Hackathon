# Copy to .env.local for local development. Set the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.

# Signs the OTP tokens (any long random string, e.g. `openssl rand -hex 32`).
OTP_SECRET=

# Email delivery via Resend (https://resend.com → API Keys).
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. onboarding@resend.dev only
# delivers to the Resend account owner's own email address.
OTP_FROM_EMAIL=SafeHer <onboarding@resend.dev>

# SMS delivery via Fast2SMS (https://www.fast2sms.com → Dev API).
# Indian numbers need an approved DLT template and wallet balance.
FAST2SMS_AUTH_KEY=
FAST2SMS_ROUTE=otp

# Optional: set to 1 to show the code on screen instead of sending it.
# Only for testing — never enable this on a public deployment.
# OTP_DEMO=
